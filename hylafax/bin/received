#!/bin/sh
# A fax arrived. faxgetty runs this (as uucp, in the spool folder) with:
#   file device commid reason [caller number] [Asterisk's call name] [called number]
# It copies the image and writes a ticket into the engine's volume (so both
# survive a new container); the engine's hand-over (as root) brings the image
# into Faxbot's data folder, hands it to Faxbot, and keeps the ticket until
# Faxbot has the fax. Nothing here talks to the network.
set -u

state=${FAXBOT_ENGINE_STATE:-/var/lib/faxbot-engine}
file=${1:-}
commid=$(printf '%s' "${3:-}" | tr -cd '0-9')
reason=$(printf '%s' "${4:-}" | tr -cd 'A-Za-z0-9 .,:()_-' | cut -c1-200)
caller=$(printf '%s' "${5:-}" | tr -cd '0-9+')
# Asterisk names the call <token>.<called digits> in the caller name; the dialed
# number (seventh argument) is used only when a modem passes one.
name=$(printf '%s' "${6:-}" | tr -cd '0-9.')
token=${name%%.*}
called=''
case $name in *.*) called=${name#*.} ;; esac
[ -n "$called" ] || called=$(printf '%s' "${7:-}" | tr -cd '0-9+')

case $file in
  recvq/fax[0-9]*.tif) ;;
  *) printf 'faxbot-received: unexpected file %s\n' "$file" >&2; exit 1 ;;
esac
[ -f "$file" ] || { printf 'faxbot-received: no image for this call\n' >&2; exit 1; }
# HylaFAX leaves the communication ID empty when two lines begin a session at the same moment (Asterisk
# rings every free line for one call): the fax is kept under its receive-queue number instead, never refused.
queued=''
if [ -z "$commid" ]; then
  commid=0
  queued=$(printf '%s' "${file#recvq/fax}" | tr -cd '0-9')-
fi

# What the engine knows about the reception, from the image and the session log.
info=$(faxinfo "$file" 2>/dev/null)
pages=$(printf '%s\n' "$info" | sed -n 's/^ *Pages: *//p' | tr -cd '0-9')
station=$(printf '%s\n' "$info" | sed -n 's/^ *Sender: *//p' | head -1)
rate=$(printf '%s\n' "$info" | sed -n 's/^ *SignalRate: *//p' | head -1)
format=$(printf '%s\n' "$info" | sed -n 's/^ *DataFormat: *//p' | head -1)
recv=$(printf '%s\n' "$info" | sed -n 's/^ *TimeToRecv: *//p' | head -1 \
  | awk -F: '{ s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i; print s }')
log=log/c$commid
sslfax=false offered=''
if [ -f "$log" ]; then
  grep -q -E 'SSL Fax connection (was successful|detected)' "$log" && sslfax=true
  if grep -q -E 'REMOTE (wants internet fax|TSA "ssl://)' "$log"; then offered=true; else offered=false; fi
  grep -q 'SSL Fax client accept failure' "$log" && sslfax=false
fi
case $rate in *SSL*) sslfax=true offered=true ;; esac

# The communication ID restarts with a new spool; the arrival time keeps names unique.
received=$(date +%s)
key=$commid-$queued$received
copy=$state/received/$key.tif
cp "$file" "$copy.part" && mv -f "$copy.part" "$copy" || { printf 'faxbot-received: image not kept\n' >&2; exit 1; }

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }
ticket=$state/received/$key.ticket
temporary=$state/received/.$key.ticket
{
  printf 'image=%s\nspool_file=%s\ncommid=%s\nkey=%s\ncaller=%s\ntoken=%s\ncalled=%s\npages=%s\n' \
    "$copy" "$file" "$commid" "$key" "$caller" "$token" "$called" "${pages:-0}"
  printf 'reason64=%s\nstation64=%s\nrate64=%s\nformat64=%s\n' \
    "$(b64 "$reason")" "$(b64 "$station")" "$(b64 "$rate")" "$(b64 "$format")"
  printf 'recv_seconds=%s\nsslfax=%s\noffered=%s\nreceived=%s\n' "$recv" "$sslfax" "$offered" "$received"
} > "$temporary" && mv -f "$temporary" "$ticket"
