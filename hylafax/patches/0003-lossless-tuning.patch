+/*
+ * Encode a raster as one BIE with the T.85 settings: D = 0 layers, order 0
+ * (HITOLO, SEQ, ILEAVE and SMID off), one plane, L0 = 128, MY = 0, and the
+ * given options and MX.  jbg_enc_out leaves the raster as it was, so one
+ * raster serves every candidate (Faxbot's build-time test checks this).
+ */
+static void
+encodeJBIG(u_char* raster, u_int width, uint32_t rows, int options, int mx, fxStackBuffer& out)
+{
+    unsigned char *pmap[1];
+    pmap[0] = raster;
+    struct jbg_enc_state jbigstate;
+    out.reset();
+    jbg_enc_init(&jbigstate, width, rows, 1, pmap, bufferJBIGData, &out);
+    /*
+     * T.85 requires "single-progressive sequential coding" and thus:
+     *
+     * Dl = 0, D = 0, P = 1 are required
+     * L0 = 128 is suggested (and appears to be standard among senders)
+     * Mx = 0 to 127 (and 0 appears to be standard)
+     * My = 0, HITOLO = 0, SEQ = 0, ILEAVE = 0, SMID = 0
+     * TPDON = 0, DPON = 0, DPPRIV = 0, DPLAST = 0
+     * LRLTWO and TPBON may each be 0 or 1 (T.85 Table 1)
+     *
+     * As these settings vary from the library's defaults, we carefully
+     * specify all of them.
+     */
+    jbg_enc_options(&jbigstate, 0, options, 128, mx, 0);
+    jbg_enc_out(&jbigstate);
+    jbg_enc_free(&jbigstate);
 }
 #endif /* HAVE_JBIG */
 
+/*
+ * Faxbot: milliseconds since ``start''.
+ */
+static u_long
+millisSince(const struct timeval& start)
+{
+    struct timeval now;
+    gettimeofday(&now, NULL);
+    long ms = (now.tv_sec - start.tv_sec)*1000L + (now.tv_usec - start.tv_usec)/1000L;
+    return ms < 0 ? 0 : (u_long) ms;
+}
+
+/*
+ * Faxbot: SHA-256 (hex) of the packed raster that is coded, rows of
+ * byteWidth bytes, 1 = black; the receiver decodes exactly this raster.
+ * Empty without OpenSSL.
+ */
+static void
+digestRaster(const u_char* raster, u_long length, char* hex)
+{
+    hex[0] = '\0';
+#if defined(HAVE_SSL)
+    unsigned char md[EVP_MAX_MD_SIZE];
+    unsigned int mdlen = 0;
+    if (EVP_Digest(raster, length, md, &mdlen, EVP_sha256(), NULL) == 1 && mdlen == 32) {
+	for (u_int i = 0; i < mdlen; i++)
+	    snprintf(hex + 2*i, 3, "%02x", md[i]);
+    }
+#endif
+}
+
+/*
+ * Faxbot: one row's code length in bits, EOL and tag bit excluded, from a
+ * scratch encoder; ``ref'' (two-dimensional coding) is overwritten.
+ */
+static u_long
+codeBits(G3Encoder& meter, fxStackBuffer& scratch, const u_char* row, u_int width, u_char* ref)
+{
+    scratch.reset();
+    meter.setupEncoder(FILLORDER_MSB2LSB, true, false);
+    meter.encode(row, width, 1, ref);
+    return meter.getBitCount() - 13;
+}
