diff -ruN a/faxd/LosslessTuning.h b/faxd/LosslessTuning.h
--- a/faxd/LosslessTuning.h
+++ b/faxd/LosslessTuning.h
@@ -0,0 +1,149 @@
+/*
+ * Faxbot: lossless tuning of the page coding faxd sends (MemoryDecoder::convertDataFormat).
+ *
+ * Both choices below change only how the same pixels are coded; the receiver
+ * decodes exactly the raster faxd would have sent without them.
+ *
+ * MR (T.4 two-dimensional coding).  T.4 4.2.1.3.4 bounds the run of
+ * two-dimensionally coded lines after a one-dimensional line by K-1, and
+ * every line carries its own tag bit saying which coding follows (T.4
+ * 4.2.1.3.1), so a one-dimensional line may come earlier than every K lines.
+ * HylaFAX resets on a fixed schedule (y % K == 0).  scheduleMR() chooses,
+ * by dynamic programming, the legal schedule with the fewest bytes on the
+ * line, using the bytes this encoder and Class1Send actually produce:
+ *
+ *  - G3Encoder writes the first EOL unaligned and byte-aligns every later EOL
+ *    so that it ends on a byte boundary (G3Encoder::encode), so each row's
+ *    bytes depend only on its own code length;
+ *  - without ECM, Class1Modem::sendPage copies the first two bytes, then
+ *    zero-fills every stretch from one EOL to the next (and the last row)
+ *    up to the negotiated minimum scan line size; with ECM that size is 0.
+ *
+ * With D[y][j] the fewest bytes through row y with j two-dimensional rows
+ * since the last one-dimensional row:
+ *
+ *     D[0][0]   = cost(0, a[0])
+ *     D[y][0]   = cost(y, a[y]) + min_j D[y-1][j]
+ *     D[y][j]   = cost(y, b[y]) + D[y-1][j-1]          1 <= j <= K-1
+ *
+ * a[y] and b[y] are row y's one- and two-dimensional code lengths (the
+ * reference row is always the previous raster row, whatever its coding), so
+ * the recurrence is exact.  Ties keep the more one-dimensional schedule: the
+ * lowest j wins every minimum, which also makes the result deterministic for
+ * Faxbot's own measurement (api/app/pages/coding.py).
+ *
+ * JBIG (T.85).  T.85 Table 1 allows typical prediction (TPBON), the two-line
+ * template (LRLTWO) and adaptive template moves up to MX 127 at L0 = 128, so
+ * every T.85 receiver must decode them.  JBIG_CANDIDATES lists the settings
+ * tried; the page goes with the smallest BIE, ties to the lower options, then
+ * the lower MX.  On Faxbot's 20-page synthetic corpus this grid of 12 gave
+ * the same total as the full grid of 24 (MX 16, 64 and 127 never won), at
+ * half the encoding time, which is spent during the call.
+ */
+#ifndef _LosslessTuning_
+#define _LosslessTuning_
+
+namespace LosslessTuning {
+
+// Options (JBG_TPBON = 0x08, JBG_LRLTWO = 0x40) and MX, in tie-break order.
+static const int JBIG_OPTIONS[4] = { 0x00, 0x08, 0x40, 0x48 };
+static const int JBIG_MX[3] = { 0, 8, 32 };
+static const unsigned int JBIG_CANDIDATES = 12;
+
+inline int jbigOptions(unsigned int candidate) { return JBIG_OPTIONS[candidate / 3]; }
+inline int jbigMX(unsigned int candidate) { return JBIG_MX[candidate % 3]; }
+
+/*
+ * The bytes row y adds to an MR page of `rows` rows (`bits` its code length,
+ * EOL and tag excluded), after the two leading bytes Class1Send copies as they
+ * are, and with the zero fill up to `minLen` bytes it inserts without ECM.
+ */
+inline unsigned long
+mrRowBytes(unsigned long bits, unsigned long row, unsigned long rows, unsigned long minLen)
+{
+    unsigned long bytes;
+    if (row == 0)	// EOL, tag, code, and the next row's aligned EOL (if any)
+	bytes = (rows == 1 ? (13 + bits + 7) / 8 : (25 + bits + 7) / 8) - 2;
+    else if (row + 1 == rows)	// tag and code, flushed: no EOL follows
+	bytes = (1 + bits + 7) / 8;
+    else		// tag, code, fill and the next row's aligned EOL
+	bytes = (13 + bits + 7) / 8;
+    return bytes < minLen ? minLen : bytes;
+}
+
+/*
+ * The fewest-bytes legal schedule: oneD[y] true for a one-dimensional row.
+ * a and b hold each row's one- and two-dimensional code lengths (b[0] is not
+ * read: the first row is always one-dimensional).  Returns the page's bytes
+ * (the two leading bytes included), or 0 when rows or k is 0 or memory runs
+ * out (oneD is then untouched).
+ */
+inline unsigned long
+scheduleMR(const unsigned long* a, const unsigned long* b, unsigned long rows,
+    unsigned int k, unsigned long minLen, bool* oneD)
+{
+    if (rows == 0 || k == 0)
+	return 0;
+    const unsigned long NONE = (unsigned long) -1;
+    unsigned long* cost = new unsigned long[2*k];
+    unsigned char* from = new unsigned char[rows*k];
+    if (!cost || !from) {
+	delete[] cost;
+	delete[] from;
+	return 0;
+    }
+    unsigned long* cur = cost;
+    unsigned long* next = cost + k;
+    for (unsigned int j = 0; j < k; j++)
+	cur[j] = NONE;
+    cur[0] = mrRowBytes(a[0], 0, rows, minLen);
+    from[0] = 0;
+    for (unsigned long y = 1; y < rows; y++) {
+	unsigned int best = 0;
+	for (unsigned int j = 1; j < k; j++)
+	    if (cur[j] < cur[best])
+		best = j;
+	next[0] = cur[best] + mrRowBytes(a[y], y, rows, minLen);
+	from[y*k] = (unsigned char) best;
+	unsigned long two = mrRowBytes(b[y], y, rows, minLen);
+	for (unsigned int j = 1; j < k; j++) {
+	    next[j] = cur[j-1] == NONE ? NONE : cur[j-1] + two;
+	    from[y*k + j] = (unsigned char) (j-1);
+	}
+	unsigned long* swap = cur;
+	cur = next;
+	next = swap;
+    }
+    unsigned int state = 0;
+    for (unsigned int j = 1; j < k; j++)
+	if (cur[j] < cur[state])
+	    state = j;
+    unsigned long total = 2 + cur[state];
+    for (unsigned long y = rows; y-- > 0;) {
+	oneD[y] = (state == 0);
+	state = from[y*k + state];
+    }
+    delete[] cost;
+    delete[] from;
+    return total;
+}
+
+/*
+ * The bytes of HylaFAX's own fixed schedule (a one-dimensional row every k
+ * rows), with the same cost model, for comparison in the session log.
+ */
+inline unsigned long
+fixedMRBytes(const unsigned long* a, const unsigned long* b, unsigned long rows,
+    unsigned int k, unsigned long minLen)
+{
+    if (rows == 0 || k == 0)
+	return 0;
+    unsigned long total = 2;
+    for (unsigned long y = 0; y < rows; y++)
+	total += mrRowBytes(y % k == 0 ? a[y] : b[y], y, rows, minLen);
+    return total;
+}
+
+}	// namespace LosslessTuning
+
+#endif /* _LosslessTuning_ */
