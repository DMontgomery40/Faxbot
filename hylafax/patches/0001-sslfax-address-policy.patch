diff -ruN a/faxd/sslfaxpolicy.h b/faxd/sslfaxpolicy.h
--- a/faxd/sslfaxpolicy.h	1969-12-31 17:00:00
+++ b/faxd/sslfaxpolicy.h	2026-10-04 21:29:57
@@ -0,0 +1,72 @@
+/*
+ * Faxbot: where the SSL Fax client may connect, and how the advertised
+ * address is shown in logs.
+ *
+ * The far end of a fax call names the host and port to connect to (in its
+ * CSA or TSA frame). The client resolves that host once and refuses
+ * addresses no fax receiver on the internet uses: this network, private,
+ * shared (carrier NAT), loopback, link-local (including cloud metadata),
+ * IETF protocol, benchmarking, multicast and reserved ranges. The single
+ * exception is this engine's own listener (Class1SSLFaxInfo), compared as
+ * the exact advertised "host:port", so a fax the installation sends to
+ * itself can still use SSL Fax. There is no setting that turns the check off.
+ *
+ * The passcode in an advertised address is never written to a log.
+ */
+#ifndef _SSLFAXPOLICY_
+#define _SSLFAXPOLICY_
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <strings.h>
+
+/* 1 when the IPv4 address (host byte order) is one an advertised SSL Fax host must never name. */
+static inline int sslFaxRefusedAddress(uint32_t a)
+{
+    if ((a & 0xFF000000u) == 0x00000000u) return 1;	/* 0.0.0.0/8 this network */
+    if ((a & 0xFF000000u) == 0x0A000000u) return 1;	/* 10.0.0.0/8 private */
+    if ((a & 0xFFC00000u) == 0x64400000u) return 1;	/* 100.64.0.0/10 shared address space */
+    if ((a & 0xFF000000u) == 0x7F000000u) return 1;	/* 127.0.0.0/8 loopback */
+    if ((a & 0xFFFF0000u) == 0xA9FE0000u) return 1;	/* 169.254.0.0/16 link-local, cloud metadata */
+    if ((a & 0xFFF00000u) == 0xAC100000u) return 1;	/* 172.16.0.0/12 private */
+    if ((a & 0xFFFFFF00u) == 0xC0000000u) return 1;	/* 192.0.0.0/24 IETF protocol assignments */
+    if ((a & 0xFFFF0000u) == 0xC0A80000u) return 1;	/* 192.168.0.0/16 private */
+    if ((a & 0xFFFE0000u) == 0xC6120000u) return 1;	/* 198.18.0.0/15 benchmarking */
+    if ((a & 0xF0000000u) == 0xE0000000u) return 1;	/* 224.0.0.0/4 multicast */
+    if ((a & 0xF0000000u) == 0xF0000000u) return 1;	/* 240.0.0.0/4 reserved, broadcast */
+    return 0;
+}
+
+/* 1 when the advertised "host:port" is exactly this engine's own listener. */
+static inline int sslFaxOwnListener(const char* advertised, const char* own)
+{
+    return advertised && own && *own && strcasecmp(advertised, own) == 0;
+}
+
+/*
+ * Copy an advertised address for a log line with any passcode hidden:
+ * "ssl://secret@host:port" becomes "ssl://(passcode hidden)@host:port".
+ */
+static inline void sslFaxShown(const char* in, char* out, size_t size)
+{
+    const char* hidden = "ssl://(passcode hidden)@";
+    if (!size) return;
+    out[0] = '\0';
+    if (!in) return;
+    if (strncmp(in, "ssl://", 6) == 0) {
+	const char* at = strrchr(in + 6, '@');
+	if (at) {
+	    size_t n = strlen(hidden);
+	    if (n >= size) n = size - 1;
+	    memcpy(out, hidden, n);
+	    out[n] = '\0';
+	    strncat(out, at + 1, size - n - 1);
+	    return;
+	}
+    }
+    strncpy(out, in, size - 1);
+    out[size - 1] = '\0';
+}
+
+#endif
