+
+/*
+ * Polled transmission (Faxbot): documents held in pollq for a caller.
+ *
+ * Each held document is a TIFF with a sidecar of the same name and the
+ * suffix ".poll" (see polldoc.h).  The sidecars are read before the DIS
+ * goes out, so the scan must stay short: a few small files.  Only the
+ * documents held for the caller's number are kept.
+ */
+u_int
+FaxServer::pollHeldDocuments(const fxStr& caller)
+{
+    heldCount = 0;
+    DIR* dir = Sys::opendir(FAX_POLLDIR);
+    if (dir == NULL)
+	return (0);
+    struct dirent* dp;
+    const size_t suffix = strlen(POLLDOC_SUFFIX);
+    while ((dp = readdir(dir)) != NULL && heldCount < POLL_HELD_MAX) {
+	size_t n = strlen(dp->d_name);
+	if (n <= suffix || strcmp(dp->d_name + n - suffix, POLLDOC_SUFFIX) != 0)
+	    continue;
+	fxStr sidecar = fxStr(FAX_POLLDIR "/") | dp->d_name;
+	fxStr document = sidecar.head(sidecar.length() - suffix) | ".tif";
+	int fd = Sys::open(sidecar, O_RDONLY);
+	if (fd < 0)
+	    continue;
+	char text[4096];
+	ssize_t got = Sys::read(fd, text, sizeof (text) - 1);
+	Sys::close(fd);
+	if (got <= 0)
+	    continue;
+	text[got] = '\0';
+	PollDoc doc;
+	if (!pollDocParse(text, &doc) || !pollNumberMatch(doc.number, caller))
+	    continue;
+	struct stat sb;
+	if (Sys::stat(document, sb) < 0 || !S_ISREG(sb.st_mode))
+	    continue;
+	heldDocs[heldCount] = doc;
+	heldFiles[heldCount] = document;
+	heldCount++;
+    }
+    closedir(dir);
+    if (heldCount)
+	traceProtocol("POLLED FAX: %u document(s) held for caller \"%s\"", heldCount, (const char*) caller);
+    return (heldCount);
+}
+
+/*
+ * The caller answered our DIS with DTC: choose the held document its SEP
+ * and PWD name and send it, or refuse with DCN.  Either way PolledCmd
+ * (faxGettyApp) hears what happened.
+ */
+void
+FaxServer::recvPolled(const CallID& callid, FaxMachineInfo& clientInfo,
+    const fxStr& sep, const fxStr& pwd, const fxStr& cig, fxStr& emsg)
+{
+    fxStr caller(callid.size() > CallID::NUMBER ? callid.id(CallID::NUMBER) : "");
+    traceProtocol("POLLED FAX: begin (caller \"%s\", CIG \"%s\", SEP \"%s\", PWD %s)",
+	(const char*) caller, (const char*) cig, (const char*) sep, pwd.length() ? "given" : "none");
+    int reason = POLL_OK;
+    int chosen = pollChoose(heldDocs, heldCount, sep, pwd, &reason);
+    u_int npages = 0;
+    fxStr file, job;
+    emsg = "";
+    if (chosen < 0) {
+	emsg = fxStr::format("Polling refused: %s", pollRefusal(reason));
+	traceProtocol("POLLED FAX: %s", (const char*) emsg);
+	fxStr dcn;
+	if (!modem->pollRefuse(dcn) && dcn != "")
+	    traceProtocol("POLLED FAX: %s", (const char*) dcn);
+    } else {
+	file = heldFiles[chosen];
+	job = heldDocs[chosen].job;
+	setServerStatus("Sending held document to %s", (const char*) caller);
+	if (sendPolledDocument(file, heldDocs[chosen], caller, cig, clientInfo, npages, emsg)) {
+	    traceProtocol("POLLED FAX: %s sent to \"%s\", %u pages in %s",
+		(const char*) file, (const char*) caller, npages, fmtTime(getFileTransferTime()));
+	} else {
+	    if (emsg == "") emsg = "fax page transmission failure {E053}";
+	    traceProtocol("POLLED FAX: %s not sent to \"%s\": %s",
+		(const char*) file, (const char*) caller, (const char*) emsg);
+	}
+    }
+    traceProtocol("POLLED FAX: end");
+    notifyPolled(file, emsg, npages, caller, cig, sep, job, callid);
+}
+
+/*
+ * Session parameters one page of a held document needs, as
+ * faxQueueApp::setupParams derives them for a queued job.
+ */
+static void
+heldPageParams(TIFF* tif, Class2Params& params, const FaxMachineInfo& info)
+{
+    params.jp = 0;
+    uint16_t compression = 0;
+    (void) TIFFGetField(tif, TIFFTAG_COMPRESSION, &compression);
+    if (compression == COMPRESSION_CCITTFAX4) {
+	params.df = DF_2DMMR;
+    } else {
+	uint32_t g3opts = 0;
+	TIFFGetField(tif, TIFFTAG_GROUP3OPTIONS, &g3opts);
+	params.df = (g3opts&GROUP3OPT_2DENCODING ? DF_2DMR : DF_1DMH);
+    }
+    uint32_t w = 1728;
+    TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &w);
+    params.setPageWidthInPixels((u_int) w);
+    float yres = 0, xres = 0;
+    if (TIFFGetField(tif, TIFFTAG_YRESOLUTION, &yres) && TIFFGetField(tif, TIFFTAG_XRESOLUTION, &xres)) {
+	uint16_t resunit = RESUNIT_INCH;
+	TIFFGetFieldDefaulted(tif, TIFFTAG_RESOLUTIONUNIT, &resunit);
+	if (resunit == RESUNIT_CENTIMETER) {
+	    yres *= 25.4;
+	    xres *= 25.4;
+	}
+	params.setRes((u_int) xres, (u_int) yres);
+    } else {
+	uint32_t l = 0;
+	TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &l);
+	yres = (l < 1450 ? 98 : 196);		// B4 at 98 lpi is ~1400 lines
+	params.setRes(204, (u_int) yres);
+    }
+    if (info.getMaxPageLengthInMM() != (u_short) -1 && yres > 0) {
+	uint32_t h = 0;
+	TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &h);
+	params.setPageLengthInMM((u_int) (h / yres * 25.4));
+    } else
+	params.ln = LN_INF;
+}
+
+/*
+ * Send a held document to the caller that polled for it.  This is
+ * FaxServer::sendFax from the point after the DIS, on a call we did not
+ * place: the DTC gives the receiver's capabilities (pollTransmitBegin),
+ * the parameters are chosen as for any send, and Phase B, C and D run
+ * through the same code (sendFaxPhaseB, Class1Modem::sendPhaseB).
+ * Nothing is queued: the request lives in memory only.
+ *
+ * Timing (T.30 5.3.6.1.4, Figure 5-2b): the caller repeats its DTC after
+ * T4 (3 s +/- 15%) without a response, so the DCS must start inside it;
+ * sendTraining begins with the 75 ms switching pause and V.21, as after
+ * a DIS, so the delay is the document scan below (a few TIFF directory
+ * reads) plus the usual prologue.
+ */
+bool
+FaxServer::sendPolledDocument(const fxStr& file, const PollDoc& doc, const fxStr& caller,
+    const fxStr& cig, FaxMachineInfo& clientInfo, u_int& npages, fxStr& emsg)
+{
+    npages = 0;
+    useDF = false;
+    formatSize[0] = formatSize[1] = 0;
+    FaxRequest req(fxStr::null);		// no queue file
+    req.jobid = doc.job[0] ? doc.job : "polled";
+    req.external = caller;
+    req.number = caller;
+    req.mailaddr = "polled";
+    req.sender = "polled";
+    req.tsi = doc.tsi;
+    if (doc.tagline[0]) {
+	req.tagline = doc.tagline;
+	req.desiredtl = 1;
+    }
+    req.items.append(FaxItem(FaxRequest::send_fax, 0, fxStr::null, file));
+    /*
+     * The page handling string faxq prepares for a job: each page's
+     * parameters (4 hex digits) and the post-page message after it, MPS
+     * between pages and EOP after the last.  The holder prepares every
+     * page of a held document alike (Faxbot does), so no page needs EOM:
+     * a document whose pages differ is refused rather than sent wrongly.
+     */
+    TIFF* tif = TIFFOpen(file, "r");
+    if (tif == NULL) {
+	emsg = "Can not open held document";
+	return (false);
+    }
+    Class2Params first, page;
+    u_int pages = 0;
+    bool uniform = true;
+    do {
+	heldPageParams(tif, page, clientInfo);
+	if (pages++ == 0)
+	    first = page;
+	else if (page.vr != first.vr || page.wd != first.wd || page.ln != first.ln || page.df != first.df)
+	    uniform = false;
+	req.pagehandling.append(page.encodePage());
+	req.pagehandling.append(TIFFLastDirectory(tif) ? 'P' : 'S');
+    } while (TIFFReadDirectory(tif));
+    TIFFClose(tif);
+    if (!uniform) {
+	emsg = "The held document's pages differ in format; it is not sent";
+	return (false);
+    }
+    req.totpages = pages;
+
+    clientParams.decodePage(req.pagehandling);
+    clientParams.df = fxmin(modem->getBestDataFormat(), (u_int) req.desireddf);
+    clientParams.br = fxmin(modem->getBestSignallingRate(), (u_int) req.desiredbr);
+    clientParams.ec = (modem->supportsECM() ? req.desiredec : EC_DISABLE);
+    clientParams.st = fxmax(modem->getBestScanlineTime(), (u_int) req.desiredst);
+    clientParams.bf = BF_DISABLE;
+    if (!modem->sendSetup(req, clientParams, emsg))
+	return (false);
+    if (!modem->pollTransmitBegin(clientCapabilities, emsg))
+	return (false);
+    clientInfo.setCSI(cig);
+    fxStr clientdis;
+    clientCapabilities.asciiEncode(clientdis);
+    clientInfo.setDIS(clientdis);
+    if (!sendClientCapabilitiesOK(req, clientInfo, emsg)) {
+	if (!emsg.length()) emsg = "send failed during Phase B negotiation";
+	return (false);
+    }
+    modem->sendSetupPhaseB(req.passwd, req.subaddr);
+    /*
+     * The document's own station ID (the holder's reply number), as
+     * UseJobTSI gives a job its own; the line's ID comes back afterwards.
+     */
+    fxStr lid(getLocalIdentifier());
+    if (doc.tsi[0])
+	setLocalIdentifier(doc.tsi);
+    fileStart = pageStart = Sys::now();
+    traceProtocol("SEND file \"%s\"", (const char*) file);
+    bool sent = sendFaxPhaseB(req, req.items[0], clientInfo, BATCH_FIRST|BATCH_LAST, true);
+    if (doc.tsi[0])
+	setLocalIdentifier(lid);
+    modem->sendEnd();				// DCN
+    npages = req.npages;
+    if (!sent) {
+	emsg = req.notice;
+	return (false);
+    }
+    return (true);
+}
+
+/*
+ * Handle notification that a caller polled a held document (Faxbot).
+ */
+void
+FaxServer::notifyPolled(const fxStr& qfile, const fxStr& reason, u_int npages,
+    const fxStr& caller, const fxStr&, const fxStr&, const fxStr&, const CallID&)
+{
+    if (reason != "")
+	traceServer("POLLED FAX (%s): caller %s got no document: %s"
+	    , (const char*) getCommID()
+	    , (const char*) caller
+	    , (const char*) reason
+	);
+    else
+	traceServer("POLLED FAX (%s): %s sent to caller %s, %u pages"
+	    , (const char*) getCommID()
+	    , (const char*) qfile
+	    , (const char*) caller
+	    , npages
+	);
 }
 
