+/*
+ * Polled transmission (Faxbot): the caller polls us for a document we
+ * hold.  The server says before recvBegin whether one is held for the
+ * caller; recvBegin then sets DIS bit 9 ("ready to transmit", T.30
+ * Table 2), and recvDCSFrames keeps the (PWD) (SEP) (CIG) DTC the caller
+ * answers with instead of (TSI) DCS.
+ */
+void
+Class1Modem::setPollable(bool hasDocument)
+{
+    pollable = hasDocument;
+}
+
+bool
+Class1Modem::getRecvDTC(fxStr& sep, fxStr& pwd, fxStr& cig)
+{
+    if (!recvdDTC)
+	return (false);
+    sep = pollSEP;
+    pwd = pollPWD;
+    cig = pollCIG;
+    return (true);
+}
+
+/*
+ * Turn the line around: from here the send protocol runs as it does
+ * after getPrologue() on a call we placed.  The DTC carries the calling
+ * station's capabilities as a receiver in the DIS format (T.30 5.3.6.1.4,
+ * Table 2 "DIS/DTC"), so it stands in for the DIS.  No NSC was read, so
+ * no HylaFAX-specific features are assumed.  The caller's T4 (3 s) runs
+ * from the end of its DTC: the first DCS must follow within it, as it
+ * does after a DIS (sendTraining: switching pause, V.21, TSI, DCS, TCF).
+ */
+bool
+Class1Modem::pollTransmitBegin(Class2Params& caps, fxStr& emsg)
+{
+    if (!recvdDTC) {
+	emsg = "No DTC was received; nothing to transmit on a poll";
+	return (false);
+    }
+    sendBegin();				// training forced; data counters reset
+    dis_caps = dtcCaps;
+    dis_caps.features = 0;
+    if (!dis_caps.isBitEnabled(FaxParams::BITNUM_T4RCVR)) {
+	emsg = "The polling station has no T.4 receiver capability {E122}";
+	protoTrace(emsg);
+	return (false);
+    }
+    caps.setFromDIS(dis_caps);
+    checkReceiverDIS(caps);
+    curcap = NULL;				// force initial setup
+    protoTrace("POLLED FAX: DTC taken as the receiver's capabilities; sending the held document");
+    emsg = "";
+    return (true);
+}
+
+/*
+ * End a DTC we cannot serve.  A station that cannot comply with a
+ * command disconnects (T.30 5.3.6.1.4, DCN).  DCN carries X = 0 here
+ * because we sent the DIS (T.30 5.3.6.1.1).
+ */
+bool
+Class1Modem::pollRefuse(fxStr& emsg)
+{
+    if (!recvdDTC)
+	return (false);
+    if (!switchingPause(emsg))
+	return (false);
+    if (!gotEOT) (void) transmitFrame(FCF_DCN|FCF_RCVR);
+    traceFCF("RECV send", FCF_DCN);
+    recvdDCN = true;
+    return (true);
+}
