diff -ruN a/faxd/polldoc.h b/faxd/polldoc.h
--- a/faxd/polldoc.h	1969-12-31 17:00:00
+++ b/faxd/polldoc.h	2026-10-08 16:15:00
@@ -0,0 +1,186 @@
+/*
+ * Faxbot: documents held in pollq for a caller to collect (polled
+ * transmission, ITU-T T.30 5.3.6.1.4 and Figure 5-2b).
+ *
+ * A held document is a TIFF in pollq next to a sidecar of the same name with
+ * the suffix ".poll": "key=value" lines naming the number the document is
+ * held for and, when the holder set them, the selective polling address
+ * (T.30 SEP) and polling password (T.30 PWD) a caller must give. faxgetty
+ * reads the sidecars before it answers: when one is held for the caller's
+ * number, its DIS says "ready to transmit" (bit 9). A DTC then chooses the
+ * document:
+ *
+ * - with SEP, the oldest document held for that number with that selective
+ *   address; without SEP, the oldest one held without a selective address
+ *   (a document the holder gave an address is never sent without it);
+ * - a document with a password is sent only to a caller whose PWD matches.
+ *
+ * The rules here are plain C with fixed buffers so the image build can
+ * compile and run polled_transmit_test.c++ against them.
+ */
+#ifndef _POLLDOC_
+#define _POLLDOC_
+
+#include <ctype.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define POLLDOC_SUFFIX ".poll"
+#define POLLDOC_TEXT 24			/* T.30 SEP/PWD: at most 20 digits */
+
+typedef struct {
+    char number[32];			/* digits of the number it is held for */
+    char selective[POLLDOC_TEXT];	/* SEP the caller must give; "" none */
+    char password[POLLDOC_TEXT];	/* PWD the caller must give; "" none */
+    char job[80];			/* the holder's reference, reported back */
+    char tsi[32];			/* station ID to send; "" the line's own */
+    char tagline[256];			/* header line format; "" none */
+    long held;				/* when it was held (seconds); oldest first */
+} PollDoc;
+
+enum {
+    POLL_OK = 0,
+    POLL_NO_DOCUMENT = 1,		/* nothing held for this caller */
+    POLL_NEEDS_SELECTIVE = 2,		/* every held document needs a SEP */
+    POLL_NO_SUCH_SELECTIVE = 3,		/* no document for the SEP given */
+    POLL_WRONG_PASSWORD = 4		/* the document's PWD was not given */
+};
+
+/* Copy the T.30 digits of s (0-9, * and #) into out; other characters are dropped. */
+static inline void pollDigits(const char* s, char* out, size_t size)
+{
+    size_t n = 0;
+    if (!size) return;
+    for (; s && *s && n + 1 < size; s++)
+	if (isdigit((unsigned char) *s) || *s == '*' || *s == '#') out[n++] = *s;
+    out[n] = '\0';
+}
+
+/*
+ * 1 when two numbers name the same line: equal digits, or one ends with the
+ * other and the shorter has at least seven digits (a number with and without
+ * its country code), the way Faxbot compares a caller with a stored number.
+ */
+static inline int pollNumberMatch(const char* a, const char* b)
+{
+    char da[64], db[64];
+    size_t la, lb;
+    pollDigits(a, da, sizeof (da));
+    pollDigits(b, db, sizeof (db));
+    la = strlen(da);
+    lb = strlen(db);
+    if (!la || !lb) return 0;
+    if (la == lb) return strcmp(da, db) == 0;
+    if (la > lb) return lb >= 7 && strcmp(da + (la - lb), db) == 0;
+    return la >= 7 && strcmp(db + (lb - la), da) == 0;
+}
+
+/* 1 when two SEP/PWD strings carry the same T.30 digits. */
+static inline int pollTextEqual(const char* a, const char* b)
+{
+    char da[POLLDOC_TEXT], db[POLLDOC_TEXT];
+    pollDigits(a, da, sizeof (da));
+    pollDigits(b, db, sizeof (db));
+    return strcmp(da, db) == 0;
+}
+
+static inline void pollCopy(char* out, size_t size, const char* value, size_t length)
+{
+    if (length >= size) length = size - 1;
+    memcpy(out, value, length);
+    out[length] = '\0';
+}
+
+/*
+ * Read a sidecar's text. Lines are "key=value"; unknown keys are ignored,
+ * so a newer Faxbot may add keys an older engine does not read. 1 when the
+ * sidecar names a number (the one thing a held document must have).
+ */
+static inline int pollDocParse(const char* text, PollDoc* doc)
+{
+    const char* line = text;
+    memset(doc, 0, sizeof (*doc));
+    while (line && *line) {
+	const char* end = strchr(line, '\n');
+	size_t length = end ? (size_t) (end - line) : strlen(line);
+	const char* eq = (const char*) memchr(line, '=', length);
+	if (eq) {
+	    size_t klen = (size_t) (eq - line);
+	    const char* value = eq + 1;
+	    size_t vlen = length - klen - 1;
+	    while (vlen && (value[vlen - 1] == '\r' || value[vlen - 1] == ' ')) vlen--;
+	    if (klen == 6 && strncmp(line, "number", 6) == 0) {
+		char raw[64];
+		pollCopy(raw, sizeof (raw), value, vlen);
+		pollDigits(raw, doc->number, sizeof (doc->number));
+	    } else if (klen == 9 && strncmp(line, "selective", 9) == 0) {
+		char raw[64];
+		pollCopy(raw, sizeof (raw), value, vlen);
+		pollDigits(raw, doc->selective, sizeof (doc->selective));
+	    } else if (klen == 8 && strncmp(line, "password", 8) == 0) {
+		char raw[64];
+		pollCopy(raw, sizeof (raw), value, vlen);
+		pollDigits(raw, doc->password, sizeof (doc->password));
+	    } else if (klen == 3 && strncmp(line, "job", 3) == 0) {
+		pollCopy(doc->job, sizeof (doc->job), value, vlen);
+	    } else if (klen == 3 && strncmp(line, "tsi", 3) == 0) {
+		pollCopy(doc->tsi, sizeof (doc->tsi), value, vlen);
+	    } else if (klen == 7 && strncmp(line, "tagline", 7) == 0) {
+		pollCopy(doc->tagline, sizeof (doc->tagline), value, vlen);
+	    } else if (klen == 4 && strncmp(line, "held", 4) == 0) {
+		char raw[32];
+		pollCopy(raw, sizeof (raw), value, vlen);
+		doc->held = strtol(raw, NULL, 10);
+	    }
+	}
+	line = end ? end + 1 : NULL;
+    }
+    return doc->number[0] != '\0';
+}
+
+/*
+ * Among the documents held for the caller (already matched by number), the
+ * index of the one a DTC with sep and pwd gets: the oldest that fits. -1 when
+ * none fits, with *reason the most specific refusal.
+ */
+static inline int pollChoose(const PollDoc* docs, int count, const char* sep, const char* pwd, int* reason)
+{
+    char wanted[POLLDOC_TEXT];
+    int chosen = -1, i, selectiveSeen = 0, passwordFailed = 0;
+    pollDigits(sep, wanted, sizeof (wanted));
+    for (i = 0; i < count; i++) {
+	const PollDoc* doc = &docs[i];
+	if (doc->selective[0]) selectiveSeen = 1;
+	if (wanted[0] ? !pollTextEqual(doc->selective, wanted) : doc->selective[0] != '\0') continue;
+	if (doc->password[0] && !pollTextEqual(doc->password, pwd)) {
+	    passwordFailed = 1;
+	    continue;
+	}
+	if (chosen < 0 || doc->held < docs[chosen].held) chosen = i;
+    }
+    if (chosen >= 0) {
+	*reason = POLL_OK;
+	return chosen;
+    }
+    if (passwordFailed) *reason = POLL_WRONG_PASSWORD;
+    else if (!count) *reason = POLL_NO_DOCUMENT;
+    else if (wanted[0]) *reason = POLL_NO_SUCH_SELECTIVE;
+    else if (selectiveSeen) *reason = POLL_NEEDS_SELECTIVE;
+    else *reason = POLL_NO_DOCUMENT;
+    return -1;
+}
+
+/* The words for a refusal, as the session log and the polled command get them. */
+static inline const char* pollRefusal(int reason)
+{
+    switch (reason) {
+    case POLL_NO_DOCUMENT:	return "no document is held for this caller";
+    case POLL_NEEDS_SELECTIVE:	return "the held document needs a selective polling address (SEP)";
+    case POLL_NO_SUCH_SELECTIVE: return "no document is held for that selective polling address (SEP)";
+    case POLL_WRONG_PASSWORD:	return "the polling password (PWD) does not match the held document";
+    }
+    return "";
+}
+
+#endif
