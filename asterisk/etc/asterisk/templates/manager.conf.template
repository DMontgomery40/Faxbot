[general]
enabled=yes
webenabled=no
port=5038
bindaddr=0.0.0.0

[${ASTERISK_AMI_USERNAME}]
secret=${ASTERISK_AMI_PASSWORD}
read=system,call,user
; system and command let Faxbot check for calls in progress and restart Asterisk
; to load new trunk settings; the manager port stays on the private network.
write=originate,reporting,system,command
displayconnects=no
