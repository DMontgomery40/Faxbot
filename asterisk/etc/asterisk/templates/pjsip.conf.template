[global]
type=global
user_agent=Faxbot-Asterisk

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

; Trunk endpoint
[trunk-aor]
type=aor
contact=sip:${SIP_SERVER}
qualify_frequency=0

[trunk-auth]
type=auth
auth_type=userpass
username=${SIP_USERNAME}
password=${SIP_PASSWORD}

[trunk-endpoint]
type=endpoint
transport=transport-udp
aors=trunk-aor
outbound_auth=trunk-auth
context=faxout
disallow=all
allow=ulaw,alaw
; T.38 UDPTL settings
t38_udptl=yes
t38_udptl_ec=redundancy
t38_udptl_maxdatagram=400
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
direct_media=no
from_domain=${SIP_FROM_DOMAIN}
from_user=${SIP_USERNAME}

[trunk-identify]
type=identify
endpoint=trunk-endpoint
match=${SIP_SERVER}

; Explicit SIP_REGISTER=true appends registration at startup when required.
