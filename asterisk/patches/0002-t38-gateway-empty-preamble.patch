+/*!
+ * \brief Faxbot: end a V.21 preamble that carried no HDLC frame (spandsp 0.0.6).
+ *
+ * A T.38 sender relaying a fax answer that began before the call switched to
+ * T.38 can send a V.21 preamble indicator followed by an HDLC signal end with no
+ * data (live over Telnyx, 5 October 2026: twice, before the first DIS). In
+ * spandsp 0.0.6 the gateway's V.21 transmitter then sends flags forever: its
+ * HDLC underflow handler moves on only from a buffer marked ready for output,
+ * so the change queued behind the empty preamble never runs, and the fax
+ * machine behind the gateway never hears the answer. When the next item for the
+ * fax machine is an indicator and no frame is loaded, the preamble was empty:
+ * end the transmitter, cutting its remaining timed flags so it does not fall
+ * behind the T.38 stream (spandsp would then wipe a frame that arrived while it
+ * lagged). In every other state this changes nothing: a normal frame end is
+ * already ended by spandsp itself, with its two closing flags.
+ */
+#define FAXBOT_SPANDSP_FLAG_INDICATOR 0x100	/* FLAG_INDICATOR in spandsp 0.0.6's t38_gateway.c */
+
+static void faxbot_end_empty_preamble(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	t38_gateway_hdlc_state_t *queue = &p->t38_gw_state.core.hdlc_to_modem;
+	hdlc_tx_state_t *hdlc = &p->t38_gw_state.audio.modems.hdlc_tx;
+
+	if (queue->in == queue->out || !(queue->buf[queue->out].contents & FAXBOT_SPANDSP_FLAG_INDICATOR) || hdlc->len) {
+		return;
+	}
+	if (hdlc->flag_octets > 2) {
+		hdlc->flag_octets = 2;
+		p->faxbot_empty_preambles++;
+		ast_log(LOG_NOTICE, "Faxbot T.38 gateway on %s: the far end's V.21 signal ended with no frame; "
+			"ended it so its next frame reaches the fax machine (%u so far)\n",
+			s->chan ? ast_channel_name(s->chan) : "<gone>", p->faxbot_empty_preambles);
 	}
+	hdlc_tx_frame(hdlc, NULL, 0);
 }
 
