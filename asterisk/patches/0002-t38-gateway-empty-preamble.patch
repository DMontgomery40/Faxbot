+/*!
+ * \brief Faxbot: put one of the T.38 gateway's counts on its T.38 channel, for the line 0001 logs when
+ * the call's T.38 session ends.
+ *
+ * \param t30 the channel the gateway plays T.30 audio to; the T.38 channel is the other one
+ */
+static void faxbot_gateway_count(struct ast_fax_session *s, struct ast_channel *t30, const char *name,
+	unsigned int count)
+{
+	struct ast_channel *t38;
+	char value[12];
+
+	if (!s->chan) {
+		return;
+	}
+	t38 = (t30 == s->chan) ? ast_channel_bridge_peer(s->chan) : ast_channel_ref(s->chan);
+	if (!t38) {
+		return;
+	}
+	snprintf(value, sizeof(value), "%u", count);
+	pbx_builtin_setvar_helper(t38, name, value);
+	ast_channel_unref(t38);
+}
+
+/*!
+ * \brief Faxbot: end a V.21 preamble that carried no HDLC frame (spandsp 0.0.6).
+ *
+ * A T.38 sender relaying a fax answer that began before the call switched to
+ * T.38 can send a V.21 preamble indicator followed by an HDLC signal end with no
+ * data (live over Telnyx, 5 October 2026: twice, before the first DIS). In
+ * spandsp 0.0.6 the gateway's V.21 transmitter then sends flags forever: its
+ * HDLC underflow handler moves on only from a buffer marked ready for output,
+ * so the change queued behind the empty preamble never runs, and the fax
+ * machine behind the gateway never hears the answer. When the next item for the
+ * fax machine is an indicator and no frame is loaded, the preamble was empty:
+ * end the transmitter, cutting its remaining timed flags so it does not fall
+ * behind the T.38 stream (spandsp would then wipe a frame that arrived while it
+ * lagged). In every other state this changes nothing: a normal frame end is
+ * already ended by spandsp itself, with its two closing flags.
+ *
+ * The steps are faxbot_gateway_end_empty_preamble in faxbot_t38_gateway.h,
+ * which the replay proof (asterisk/tests/t38_gateway_replay.c) runs as well.
+ * The far end decides how often this happens, so only the first one in a call
+ * is logged; 0001's line at the end of the call has the count.
+ */
+static void faxbot_end_empty_preamble(struct ast_fax_session *s, struct ast_channel *t30, struct spandsp_pvt *p)
+{
+	if (!faxbot_gateway_end_empty_preamble(&p->t38_gw_state)) {
+		return;
 	}
+	if (!p->faxbot_empty_preambles++) {
+		ast_log(LOG_NOTICE, "Faxbot T.38 gateway on %s: the far end's V.21 signal ended with no frame; "
+			"ended it so its next frame reaches the fax machine (logged once per call; the T.38 line at "
+			"the end of the call counts them)\n", s->chan ? ast_channel_name(s->chan) : "<gone>");
+	}
+	faxbot_gateway_count(s, t30, "FAXBOT_T38_EMPTY_PREAMBLES", p->faxbot_empty_preambles);
 }
 
 /*! \brief generate T.30 packets sent to the T.30 leg of gateway
