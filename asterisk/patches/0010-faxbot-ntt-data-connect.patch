+/*! \brief Faxbot (0010): the bandwidth an NTT Data Connect call declares (b=AS, kbit/s; routing/data_connect.py) */
+#define FAXBOT_DATA_CONNECT_KBPS 64
+/*! \brief Faxbot (0010): the largest UDPTL datagram sent on one, so the session never exceeds what it declared */
+#define FAXBOT_DATA_CONNECT_DATAGRAM 160
+
+/*! \brief Faxbot (0010): whether this call asks to be an NTT Data Connect call (FAXBOT_DATA_CONNECT=yes) */
+static int faxbot_data_connect_wanted(struct ast_sip_session *session)
+{
+	const char *value;
+	int wanted;
+
+	if (!session->channel) {
+		return 0;
+	}
+	ast_channel_lock(session->channel);
+	value = pbx_builtin_getvar_helper(session->channel, "FAXBOT_DATA_CONNECT");
+	wanted = !ast_strlen_zero(value) && !strcmp(value, "yes");
+	ast_channel_unlock(session->channel);
+	return wanted;
+}
+
+/*! \brief Faxbot (0010): whether this is the first INVITE of a call chan_pjsip turned into a Data Connect offer */
+static int faxbot_data_connect_first_offer(struct ast_sip_session *session)
+{
+	return session->inv_session && session->inv_session->state == PJSIP_INV_STATE_NULL
+		&& session->t38state == T38_LOCAL_REINVITE && faxbot_data_connect_wanted(session);
+}
+
+/*!
+ * \brief Faxbot (0010): the T.38 parameters of a Data Connect call's first offer.
+ *
+ * SendFAX has not run yet, so the offer carries res_fax's own parameters (version 0, 14,400 bit/s,
+ * transferredTCF, 400-octet IFPs), the values ITU-T T.38 Annex D describes and data_connect.T38_SDP lists.
+ * The channel is marked offered, so the answer is read as the answer to this offer.
+ */
+static void faxbot_data_connect_offer(struct ast_sip_session *session, struct ast_sip_session_media *session_media,
+	struct t38_state *state)
+{
+	if (!faxbot_data_connect_first_offer(session)) {
+		return;
+	}
+	if (!state->our_parms.max_ifp) {
+		state->our_parms.version = 0;
+		state->our_parms.max_ifp = 400;
+		state->our_parms.rate = AST_T38_RATE_14400;
+		state->our_parms.rate_management = AST_T38_RATE_MANAGEMENT_TRANSFERRED_TCF;
+		ast_udptl_set_local_max_ifp(session_media->udptl, state->our_parms.max_ifp);
+	}
+	ast_channel_lock(session->channel);
+	pbx_builtin_setvar_helper(session->channel, "FAXBOT_DATA_CONNECT_RESULT", "offered");
+	ast_channel_unlock(session->channel);
+}
+
+/*! \brief Faxbot (0010): the bandwidth a Data Connect call's first offer declares, as RFC 4566's b=AS line */
+static void faxbot_data_connect_bandwidth(struct ast_sip_session *session, pj_pool_t *pool, pjmedia_sdp_media *media)
+{
+	static const pj_str_t STR_AS = { "AS", 2 };
+	pjmedia_sdp_bandw *bandwidth;
+
+	if (!faxbot_data_connect_first_offer(session) || media->bandw_count >= PJMEDIA_MAX_SDP_BANDW) {
+		return;
+	}
+	bandwidth = PJ_POOL_ZALLOC_T(pool, pjmedia_sdp_bandw);
+	if (!bandwidth) {
+		return;
+	}
+	bandwidth->modifier = STR_AS;
+	bandwidth->value = FAXBOT_DATA_CONNECT_KBPS;
+	media->bandw[media->bandw_count++] = bandwidth;
 }
 
+/*! \brief Faxbot (0010): keep only the characters of a fax or attempt identity (hexadecimal) for the event */
+static void faxbot_identity(char *out, size_t size, const char *value)
+{
+	size_t used = 0;
+
+	for (; value && *value && used + 1 < size; value++) {
+		if (isxdigit((unsigned char) *value)) {
+			out[used++] = *value;
+		}
+	}
+	out[used] = '\0';
+}
+
+/*!
+ * \brief Faxbot (0010): the answer to an NTT Data Connect call's first INVITE.
+ *
+ * A 2xx whose image stream has a port and a UDPTL peer leaves the session as an incoming T.38 offer leaves it
+ * (T38_PEER_REINVITE), so SendFAX agrees the parameters exactly as ReceiveFAX does for one, and Faxbot's
+ * datagrams are capped at FAXBOT_DATA_CONNECT_DATAGRAM octets so the session stays inside the bandwidth it
+ * declared. A 488 is the recipient's machine, or the network, refusing the offer: FAXBOT_DATA_CONNECT_RESULT is
+ * refused and a FaxDataConnect user event names the fax and attempt (and NTT's Warning, base64), so Faxbot calls
+ * again as an ordinary fax call before any page. Any other answer leaves the call as it is.
+ */
+static void faxbot_data_connect_response(struct ast_sip_session *session, struct pjsip_rx_data *rdata)
+{
+	static const pj_str_t STR_WARNING = { "Warning", 7 };
+	int code = rdata->msg_info.msg->line.status.code;
+	struct ast_sip_session_media *session_media;
+	struct t38_state *state;
+	struct ast_sockaddr peer;
+	const char *value;
+	int offered;
+
+	if (!session->channel || rdata->msg_info.msg->type != PJSIP_RESPONSE_MSG) {
+		return;
+	}
+	ast_channel_lock(session->channel);
+	value = pbx_builtin_getvar_helper(session->channel, "FAXBOT_DATA_CONNECT_RESULT");
+	offered = !ast_strlen_zero(value) && !strcmp(value, "offered");
+	ast_channel_unlock(session->channel);
+	if (!offered) {
+		return;
+	}
+
+	if (code == 488) {
+		pjsip_generic_string_hdr *header = pjsip_msg_find_hdr_by_name(rdata->msg_info.msg, &STR_WARNING, NULL);
+		char warning[256] = "", encoded[400] = "", job[64] = "", attempt[64] = "";
+
+		if (header) {
+			ast_copy_pj_str(warning, &header->hvalue, sizeof(warning));
+		}
+		ast_base64encode(encoded, (unsigned char *) warning, strlen(warning), sizeof(encoded));
+		ast_channel_lock(session->channel);
+		faxbot_identity(job, sizeof(job), pbx_builtin_getvar_helper(session->channel, "JOBID"));
+		faxbot_identity(attempt, sizeof(attempt), pbx_builtin_getvar_helper(session->channel, "FAXATTEMPT"));
+		pbx_builtin_setvar_helper(session->channel, "FAXBOT_DATA_CONNECT_RESULT", "refused");
+		ast_channel_unlock(session->channel);
+		ast_log(LOG_NOTICE, "%s: the NTT Data Connect offer was refused (488 %s)\n",
+			ast_channel_name(session->channel), warning);
+		manager_event(EVENT_FLAG_USER, "UserEvent",
+			"UserEvent: FaxDataConnect\r\nJobID: %s\r\nAttemptID: %s\r\nOutcome: refused\r\nCode: %d\r\n"
+			"Warning64: %s\r\n", job, attempt, code, encoded);
+		return;
+	}
+
+	if (code < 200 || code >= 300 || session->t38state != T38_LOCAL_REINVITE || !session->active_media_state) {
+		return;
+	}
+	session_media = session->active_media_state->default_session[AST_MEDIA_TYPE_IMAGE];
+	if (!session_media || !session_media->udptl || !(state = t38_state_get_or_alloc(session))) {
+		return; /* the answer's media is not applied yet: read again after it is */
+	}
+	ast_udptl_get_peer(session_media->udptl, &peer);
+	if (!ast_sockaddr_port(&peer)) {
+		return;
+	}
+	if (ast_udptl_get_far_max_datagram(session_media->udptl) > FAXBOT_DATA_CONNECT_DATAGRAM) {
+		ast_udptl_set_far_max_datagram(session_media->udptl, FAXBOT_DATA_CONNECT_DATAGRAM);
+	}
+	ast_channel_lock(session->channel);
+	pbx_builtin_setvar_helper(session->channel, "FAXBOT_DATA_CONNECT_RESULT", "connected");
+	ast_channel_unlock(session->channel);
+	ast_log(LOG_NOTICE, "%s: NTT Data Connect call answered with T.38\n", ast_channel_name(session->channel));
+	t38_change_state(session, session_media, state, T38_PEER_REINVITE);
+	return;
+}
