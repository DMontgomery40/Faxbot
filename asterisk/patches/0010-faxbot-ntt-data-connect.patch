+/*! \brief Faxbot (0010): whether this endpoint takes NTT Data Connect faxes (set_var=FAXBOT_DATA_CONNECT_ACCEPT=yes) */
+static int faxbot_data_connect_accepted(struct ast_sip_session *session)
+{
+	struct ast_variable *variable;
+
+	for (variable = session->endpoint->channel_vars; variable; variable = variable->next) {
+		if (!strcmp(variable->name, "FAXBOT_DATA_CONNECT_ACCEPT") && !strcmp(variable->value, "yes")) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*!
+ * \brief Faxbot (0010): an NTT Data Connect fax coming in: T.38 alone in the first INVITE, on an endpoint that
+ * takes them (Faxbot's NTT Hikari Denwa trunk).
+ *
+ * Asterisk declines T.38 in a first INVITE. Here the session goes where a peer's T.38 re-INVITE puts it
+ * (T38_PEER_REINVITE, with no rejection timer: nothing is deferred), and the answer carries res_fax's own
+ * parameters (version 0, 14,400 bit/s, the caller's rate management), so ReceiveFAX agrees them as it does for a
+ * re-INVITE. Anything else is declined as before.
+ */
+static void faxbot_data_connect_incoming(struct ast_sip_session *session, struct ast_sip_session_media *session_media,
+	struct t38_state *state, pjmedia_sdp_media *stream)
+{
+	if (session->channel || !session->inv_session || session->inv_session->role != PJSIP_ROLE_UAS
+		|| session->t38state != T38_DISABLED || !faxbot_data_connect_accepted(session)
+		|| t38_initialize_session(session, session_media)) {
+		return;
+	}
+	t38_interpret_sdp(state, session, session_media, stream);
+	state->our_parms.version = 0;
+	state->our_parms.max_ifp = 400;
+	state->our_parms.rate = AST_T38_RATE_14400;
+	state->our_parms.rate_management = state->their_parms.rate_management;
+	ast_udptl_set_local_max_ifp(session_media->udptl, state->our_parms.max_ifp);
+	session->t38state = T38_PEER_REINVITE;
 }
 
