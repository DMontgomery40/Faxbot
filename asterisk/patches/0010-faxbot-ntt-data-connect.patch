+/*!
+ * \brief Faxbot (0010): the image stream of a T.38 offer still being agreed: the pending one for a peer's re-INVITE,
+ * else the active one, for an NTT Data Connect call whose first INVITE already carried T.38 and was answered.
+ */
+static struct ast_sip_session_media *faxbot_image_media(struct ast_sip_session *session)
+{
+	struct ast_sip_session_media *session_media = session->pending_media_state->default_session[AST_MEDIA_TYPE_IMAGE];
+
+	if (!session_media && session->active_media_state) {
+		session_media = session->active_media_state->default_session[AST_MEDIA_TYPE_IMAGE];
+	}
+	return session_media;
+}
