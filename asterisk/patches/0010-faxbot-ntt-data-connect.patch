+/*!
+ * \brief Faxbot (0010): an NTT Data Connect call offers only T.38 in its first INVITE.
+ *
+ * When the channel asks for it (FAXBOT_DATA_CONNECT=yes, set by Faxbot's Originate) and the endpoint does T.38,
+ * the first offer carries one image stream instead of audio, as an outgoing T.38 re-INVITE would; res_pjsip_t38
+ * writes it (ITU-T T.38 Annex D parameters and a b=AS line) and reads the answer. Any other call is unchanged.
+ */
+static void faxbot_data_connect_media(struct ast_sip_session *session)
+{
+	struct ast_sip_session_media_state *media_state;
+	struct ast_stream *stream;
+	struct ast_format_cap *caps;
+	const char *value;
+	int wanted;
+
+	if (!session->channel || !session->endpoint->media.t38.enabled) {
+		return;
+	}
+	ast_channel_lock(session->channel);
+	value = pbx_builtin_getvar_helper(session->channel, "FAXBOT_DATA_CONNECT");
+	wanted = !ast_strlen_zero(value) && !strcmp(value, "yes");
+	ast_channel_unlock(session->channel);
+	if (!wanted) {
+		return;
+	}
+	media_state = ast_sip_session_media_state_alloc();
+	if (!media_state) {
+		return;
+	}
+	media_state->topology = ast_stream_topology_alloc();
+	stream = media_state->topology ? ast_stream_alloc("t38", AST_MEDIA_TYPE_IMAGE) : NULL;
+	caps = stream ? ast_format_cap_alloc(AST_FORMAT_CAP_FLAG_DEFAULT) : NULL;
+	if (!caps || ast_format_cap_append(caps, ast_format_t38, 0)) {
+		ao2_cleanup(caps);
+		ast_stream_free(stream);
+		ast_sip_session_media_state_free(media_state);
+		return;
+	}
+	ast_stream_set_formats(stream, caps);
+	ao2_ref(caps, -1);
+	ast_stream_set_state(stream, AST_STREAM_STATE_SENDRECV);
+	if (ast_stream_topology_set_stream(media_state->topology, 0, stream)) {
+		ast_stream_free(stream);
+		ast_sip_session_media_state_free(media_state);
+		return;
+	}
+	if (!ast_sip_session_media_state_add(session, media_state, AST_MEDIA_TYPE_IMAGE, 0)) {
+		ast_sip_session_media_state_free(media_state);
+		return;
+	}
+	ast_sip_session_media_state_free(session->pending_media_state);
+	session->pending_media_state = media_state;
+	session->t38state = T38_LOCAL_REINVITE;
+	ast_log(LOG_NOTICE, "%s: NTT Data Connect call: the first INVITE offers only T.38\n",
+		ast_channel_name(session->channel));
 }
 
