 /*! \brief Helper function for changing the T.38 state */
+/*!
+ * \brief Faxbot (0004): when T.38 started on this call and who asked for it, once per channel.
+ *
+ * FAXBOT_T38_AT is the moment in epoch milliseconds; FAXBOT_T38_BY is "far" (the far end re-invited) or
+ * "faxbot" (this side did, as SendFAX does after three CNG tones). With the answer time, Faxbot learns which
+ * numbers never ask for T.38 themselves (engine_frames.py, early T.38).
+ */
+static void faxbot_t38_started(struct ast_channel *chan, enum ast_sip_session_t38state old_state)
+{
+	struct timeval now = ast_tvnow();
+	char at[24];
+
+	ast_channel_lock(chan);
+	if (!pbx_builtin_getvar_helper(chan, "FAXBOT_T38_AT")) {
+		snprintf(at, sizeof(at), "%lld", (long long) now.tv_sec * 1000 + now.tv_usec / 1000);
+		pbx_builtin_setvar_helper(chan, "FAXBOT_T38_AT", at);
+		pbx_builtin_setvar_helper(chan, "FAXBOT_T38_BY", old_state == T38_PEER_REINVITE ? "far"
+			: old_state == T38_LOCAL_REINVITE ? "faxbot" : "");
+	}
+	ast_channel_unlock(chan);
+}
+
