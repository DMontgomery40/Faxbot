+/*! \brief Faxbot (0004): spandsp's real-time frame handler; keeps what each side said (faxbot_frames_record). */
+static void faxbot_frame_handler(t30_state_t *t30, void *user_data, int direction, const uint8_t msg[], int len)
+{
+	struct spandsp_pvt *p = user_data;
+
+	faxbot_frames_record(&p->faxbot_frames, direction, msg, len);
+}
+
+/*!
+ * \brief Faxbot (0004): what the far end's fax machine said, on the channel when the session ends, logged once.
+ *
+ * The dialplan's FaxFrames event carries these to Faxbot (engine_frames.py), for sent and received faxes alike.
+ * Hex T.30 frames, at most FAXBOT_FRAME_MAX octets each, empty when not seen: FAXBOT_FAR_DIS (its DIS or DTC),
+ * FAXBOT_DCS_FIRST and FAXBOT_DCS_LAST, FAXBOT_FAR_CSA, FAXBOT_FAR_TSA, FAXBOT_FAR_SUB and FAXBOT_FAR_NSF. Then
+ * FAXBOT_DCS_SENT (1 when this side sent the DCS), FAXBOT_DCS_RATES (each DCS's speed code, dot separated),
+ * FAXBOT_TRAININGS, FAXBOT_FTT (failures to train) and FAXBOT_IAF_USED (peer, endpoint or empty).
+ */
+static void faxbot_frames_export(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	const faxbot_frames_t *f = &p->faxbot_frames;
+	struct {
+		const char *name;
+		const faxbot_frame_t *frame;
+	} kept[] = {
+		{ "FAXBOT_FAR_DIS", &f->dis }, { "FAXBOT_DCS_FIRST", &f->dcs_first }, { "FAXBOT_DCS_LAST", &f->dcs_last },
+		{ "FAXBOT_FAR_CSA", &f->csa }, { "FAXBOT_FAR_TSA", &f->tsa }, { "FAXBOT_FAR_SUB", &f->sub },
+		{ "FAXBOT_FAR_NSF", &f->nsf },
+	};
+	char hex[2 * FAXBOT_FRAME_MAX + 1];
+	char rates[3 * FAXBOT_RATES_MAX + 1];
+	char count[12];
+	int i, first = 0, lowest = 0, rate;
+
+	if (!s->chan) {
+		return;
+	}
+	for (i = 0; i < ARRAY_LEN(kept); i++) {
+		faxbot_hex(kept[i].frame->frame, kept[i].frame->len, hex);
+		pbx_builtin_setvar_helper(s->chan, kept[i].name, hex);
+	}
+	faxbot_rates_text(f, rates, sizeof(rates));
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_DCS_RATES", rates);
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_DCS_SENT", f->dcs ? (f->dcs_sent ? "1" : "0") : "");
+	snprintf(count, sizeof(count), "%u", f->dcs);
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_TRAININGS", count);
+	snprintf(count, sizeof(count), "%u", f->ftt);
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_FTT", count);
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_IAF_USED",
+		p->faxbot_iaf == FAXBOT_IAF_PEER ? "peer" : p->faxbot_iaf == FAXBOT_IAF_ENDPOINT ? "endpoint" : "");
+	for (i = 0; i < f->rates_len; i++) {
+		rate = faxbot_dcs_rate(f->rates[i]);
+		if (!i) {
+			first = rate;
+		}
+		if (rate && (!lowest || rate < lowest)) {
+			lowest = rate;
+		}
+	}
+	faxbot_hex(f->dis.frame, f->dis.len, hex);
+	ast_log(LOG_NOTICE, "Faxbot fax frames on %s: the far end's DIS %s; %u trainings, first at %d bit/s, lowest %d "
+		"bit/s; %u failures to train%s\n", ast_channel_name(s->chan), hex[0] ? hex : "not seen", f->dcs, first,
+		lowest, f->ftt, p->faxbot_iaf ? "; Internet Aware Fax" : "");
+}
+
+/*!
+ * \brief Faxbot (0004): Internet Aware Fax sends its next chunks now, and everything queued goes out this tick.
+ *
+ * spandsp_fax_read returns one frame per 20 ms timer tick; the chunks faxbot_iaf_send_ahead adds go out here,
+ * all but the last, which spandsp_fax_read returns as usual.
+ */
+static void faxbot_iaf_send_queued(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	struct ast_frame *f;
+	int i;
+
+	for (i = 0; i < FAXBOT_IAF_AHEAD && faxbot_iaf_send_ahead(&p->t38_state); i++) {
+	}
+	while (AST_LIST_FIRST(&p->read_frames) && AST_LIST_NEXT(AST_LIST_FIRST(&p->read_frames), frame_list)) {
+		f = AST_LIST_REMOVE_HEAD(&p->read_frames, frame_list);
+		if (s->chan) {
+			ast_write(s->chan, f);
+		}
+		ast_frfree(f);
+	}
+}
