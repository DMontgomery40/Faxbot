Faxbot: count the UDPTL packets each T.38 stream sends and receives.

For the NOTICE line res_pjsip_t38 logs at the end of each T.38 session (0001):
received counts every datagram read from the stream's port, sent every
datagram the operating system accepted.

--- a/main/udptl.c
+++ b/main/udptl.c
@@ -237,6 +237,9 @@
 
 	unsigned int tx_seq_no;
 	unsigned int rx_seq_no;
+	/*! Faxbot: UDPTL packets sent and received on this stream */
+	unsigned int faxbot_sent;
+	unsigned int faxbot_received;
 
 	udptl_fec_tx_buffer_t tx[UDPTL_BUF_MASK + 1];
 	udptl_fec_rx_buffer_t rx[UDPTL_BUF_MASK + 1];
@@ -805,6 +808,7 @@
 		ast_assert(errno != EBADF);
 		return &ast_null_frame;
 	}
+	udptl->faxbot_received++;
 
 	/* Ignore if the other side hasn't been given an address yet. */
 	if (ast_sockaddr_isnull(&udptl->them)) {
@@ -1155,6 +1159,12 @@
 void ast_udptl_set_peer(struct ast_udptl *udptl, const struct ast_sockaddr *them)
 {
 	ast_sockaddr_copy(&udptl->them, them);
+}
+
+void ast_udptl_get_counts(const struct ast_udptl *udptl, unsigned int *sent, unsigned int *received)
+{
+	*sent = udptl->faxbot_sent;
+	*received = udptl->faxbot_received;
 }
 
 void ast_udptl_get_peer(const struct ast_udptl *udptl, struct ast_sockaddr *them)
@@ -1227,6 +1237,8 @@
 		if (ast_sendto(s->fd, buf, len, 0, &s->them) < 0) {
 			ast_log(LOG_NOTICE, "UDPTL (%s): Transmission error to %s: %s\n",
 				LOG_TAG(s), ast_sockaddr_stringify(&s->them), strerror(errno));
+		} else {
+			s->faxbot_sent++;
 		}
 		if (udptl_debug_test_addr(&s->them)) {
 			ast_verb(1, "UDPTL (%s): packet to %s (seq %u, len %u)\n",
--- a/include/asterisk/udptl.h
+++ b/include/asterisk/udptl.h
@@ -67,6 +67,9 @@
 
 void ast_udptl_get_peer(const struct ast_udptl *udptl, struct ast_sockaddr *them);
 
+/*! \brief Faxbot: how many UDPTL packets this stream has sent and received */
+void ast_udptl_get_counts(const struct ast_udptl *udptl, unsigned int *sent, unsigned int *received);
+
 void ast_udptl_get_us(const struct ast_udptl *udptl, struct ast_sockaddr *us);
 
 void ast_udptl_destroy(struct ast_udptl *udptl);
