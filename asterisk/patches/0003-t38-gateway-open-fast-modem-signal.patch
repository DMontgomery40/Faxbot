 	/*! Faxbot: empty V.21 preambles the gateway ended (see faxbot_end_empty_preamble) */
 	unsigned int faxbot_empty_preambles;
+	/*! Faxbot: fast modem signals left open that the gateway ended (see faxbot_end_empty_training) */
+	unsigned int faxbot_empty_trainings;
 };
 
