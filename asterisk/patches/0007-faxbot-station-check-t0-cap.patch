+/*!
+ * \brief Faxbot (0007): the far end's DIS arrived; check the station it answered as (research N5).
+ *
+ * spandsp keeps the CSI before it calls this handler on the DIS (t30.c 0.0.6), and sends DCN before any DCS,
+ * training or page when the handler answers anything but T30_ERR_OK. Only a send session with FAXBOT_CSI_EXPECT
+ * is checked; a blank or short CSI is no signal (faxbot_csi_check). With FAXBOT_CSI_REFUSE=yes a contradicting
+ * station ends the call as T30_ERR_IDENT_UNACCEPTABLE ("Far end's ident is not acceptable"); otherwise the call
+ * goes on and Faxbot records that the station differed. Reaching phase B also ends the T0 cap.
+ */
 #if SPANDSP_RELEASE_DATE >= 20120902
 /* for spandsp shaphots 3.0.0 and higher */
+static int faxbot_phase_b_handler(void *data, int result)
+#else
+/* for spandsp release 0.0.6 */
+static int faxbot_phase_b_handler(t30_state_t *t30_state, void *data, int result)
+#endif
+{
+	struct ast_fax_session *s = data;
+	struct spandsp_pvt *p = s->tech_pvt;
+	const char *csi;
+	int found;
+
+	p->faxbot_phase_b = 1;
+	if (!(s->details->caps & AST_FAX_TECH_SEND) || !p->faxbot_csi_expect[0] || p->faxbot_csi_result) {
+		return T30_ERR_OK;
+	}
+	csi = t30_get_rx_ident(p->t30_state);
+	found = faxbot_csi_check(csi, p->faxbot_csi_expect);
+	if (found == FAXBOT_CSI_NO_SIGNAL) {
+		return T30_ERR_OK;
+	}
+	if (found == FAXBOT_CSI_MATCHES) {
+		p->faxbot_csi_result = "matches";
+		return T30_ERR_OK;
+	}
+	p->faxbot_csi_result = p->faxbot_csi_refuse ? "refused" : "differs";
+	ast_log(LOG_NOTICE, "Faxbot: %s answered as a station Faxbot did not expect; %s\n",
+		s->chan ? ast_channel_name(s->chan) : "<gone>",
+		p->faxbot_csi_refuse ? "ending the call before any page" : "the fax goes on");
+	return p->faxbot_csi_refuse ? T30_ERR_IDENT_UNACCEPTABLE : T30_ERR_OK;
+}
+
+/*! \brief Faxbot (0007): FAXBOT_CSI_CHECK (matches, differs, refused or empty) and FAXBOT_T0_CAPPED (1 or empty). */
+static void faxbot_station_export(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	if (!s->chan) {
+		return;
+	}
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_CSI_CHECK", p->faxbot_csi_result ? p->faxbot_csi_result : "");
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_T0_CAPPED", p->faxbot_t0_capped ? "1" : "");
+}
+
+/*!
+ * \brief Faxbot (0007): read this send session's station check and T0 cap from the channel. The cap counts from the
+ * call's answer, so a session res_fax starts again (T.38, or audio after a refused T.38 attempt) keeps counting.
+ */
+static void faxbot_station_start(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	const char *expect;
+	long long answered;
+
+	if (!s->chan || !(s->details->caps & AST_FAX_TECH_SEND) || !ast_tvzero(p->faxbot_started)) {
+		return;
+	}
+	p->faxbot_started = ast_tvnow();
+	ast_channel_lock(s->chan);
+	/* From the answer (FAXBOT_ANSWERED), not this session's start: res_fax starts a new session on audio after a
+	 * T.38 attempt the far end refused. */
+	answered = faxbot_answered_at(pbx_builtin_getvar_helper(s->chan, "FAXBOT_ANSWERED"),
+		(long long) p->faxbot_started.tv_sec);
+	if (answered) {
+		p->faxbot_started = ast_tv(answered, 0);
+	}
+	p->faxbot_t0_ms = faxbot_t0_ms(pbx_builtin_getvar_helper(s->chan, "FAXBOT_T0_MS"));
+	expect = pbx_builtin_getvar_helper(s->chan, "FAXBOT_CSI_EXPECT");
+	ast_copy_string(p->faxbot_csi_expect, expect ? expect : "", sizeof(p->faxbot_csi_expect));
+	expect = pbx_builtin_getvar_helper(s->chan, "FAXBOT_CSI_REFUSE");
+	p->faxbot_csi_refuse = expect && !strcmp(expect, "yes");
+	ast_channel_unlock(s->chan);
+	if (p->faxbot_t0_ms) {
+		ast_log(LOG_NOTICE, "Faxbot: %s ends the call when no fax answers within %d ms\n",
+			ast_channel_name(s->chan), p->faxbot_t0_ms);
+	}
+}
+
