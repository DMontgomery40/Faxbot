 static void faxbot_frame_handler(t30_state_t *t30, void *user_data, int direction, const uint8_t msg[], int len)
 {
 	struct spandsp_pvt *p = user_data;
+	struct timeval now;
 
+	/* Faxbot (0008): 64-octet frames on this side's DCS when this fax asks for them, before the DCS is kept and
+	 * sent (faxbot_ecm_small_frames). */
+	if (p->faxbot_small_frames && faxbot_ecm_small_frames(t30, direction, msg, len)) {
+		p->faxbot_ecm.small_frames = 1;
+	}
 	faxbot_frames_record(&p->faxbot_frames, direction, msg, len);
+	/* Faxbot (0008): what error correction did, timed by the wall clock. */
+	now = ast_tvnow();
+	faxbot_ecm_record(&p->faxbot_ecm, direction, msg, len, (long long) now.tv_sec * 1000 + now.tv_usec / 1000);
+}
+
+/*!
+ * \brief Faxbot (0008): this session's error-correction frame size and T.38 protection, from the channel.
+ *
+ * FAXBOT_ECM_FRAME=64 asks for 64-octet error-correction frames on a fax this session sends (a received fax's
+ * sender chooses its own). FAXBOT_T38_PROTECT ("I.C.CE.IM.IME") sets how many times each category of T.38 packet
+ * goes (faxbot_t38_protect_parse); the T.38 setup applies it. Unset, or anything else, changes nothing.
+ */
+static void faxbot_ecm_start(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	const char *frame, *protect;
+	char asked[24] = "";
+
+	if (!s->chan) {
+		return;
+	}
+	ast_channel_lock(s->chan);
+	frame = pbx_builtin_getvar_helper(s->chan, "FAXBOT_ECM_FRAME");
+	p->faxbot_small_frames = frame && !strcmp(frame, "64") && (s->details->caps & AST_FAX_TECH_SEND);
+	protect = pbx_builtin_getvar_helper(s->chan, "FAXBOT_T38_PROTECT");
+	if (protect) {
+		ast_copy_string(asked, protect, sizeof(asked));
+	}
+	ast_channel_unlock(s->chan);
+	p->faxbot_protect = faxbot_t38_protect_parse(asked, p->faxbot_protect_counts);
+	if (p->faxbot_small_frames) {
+		ast_log(LOG_NOTICE, "Faxbot: %s asks for 64-octet error-correction frames\n", ast_channel_name(s->chan));
+	}
+	if (p->faxbot_protect) {
+		ast_log(LOG_NOTICE, "Faxbot: T.38 protection %s on %s\n", asked, ast_channel_name(s->chan));
+	} else if (asked[0]) {
+		ast_log(LOG_WARNING, "Faxbot: the T.38 protection for %s is not one Faxbot sets; none is used\n",
+			ast_channel_name(s->chan));
+	}
+}
+
+/*!
+ * \brief Faxbot (0008): how T.38 arrived on this session, on the channel: FAXBOT_T38_RX "received.recovered.missing"
+ * (packets that arrived, those UDPTL redundancy recovered, and those still missing after it, spandsp's count) and
+ * FAXBOT_T38_PROTECT_USED (the counts this session sent with, empty without protection). Nothing without T.38.
+ */
+static void faxbot_t38_rx_export(struct ast_fax_session *s, struct spandsp_pvt *p)
+{
+	char text[64] = "";
+	int *counts = p->faxbot_protect_counts;
+
+	if (!s->chan || !p->ist38 || !p->t38_core_state) {
+		return;
+	}
+	snprintf(text, sizeof(text), "%u.%u.%d", p->faxbot_rx_ifp, p->faxbot_rx_repaired,
+		p->t38_core_state->missing_packets);
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_T38_RX", text);
+	text[0] = '\0';
+	if (p->faxbot_protect) {
+		snprintf(text, sizeof(text), "%d.%d.%d.%d.%d", counts[0], counts[1], counts[2], counts[3], counts[4]);
+	}
+	pbx_builtin_setvar_helper(s->chan, "FAXBOT_T38_PROTECT_USED", text);
 }
 
