+/*! \brief Faxbot: count one T.38 packet sent (1) or received (0) for the line logged at session end */
+static void faxbot_t38_count(struct ast_sip_session *session, int sent)
+{
+	RAII_VAR(struct ast_datastore *, datastore, ast_sip_session_get_datastore(session, "t38"), ao2_cleanup);
+	struct t38_state *state = datastore ? datastore->data : NULL;
 
+	if (!state) {
+		return;
+	}
+	ast_atomic_fetchadd_int(sent ? &state->faxbot_sent : &state->faxbot_received, 1);
+	/* A gateway marks the channel when it starts (0002); look until it has, while the channel exists. */
+	if (sent && !state->faxbot_gateway && session->channel
+		&& pbx_builtin_getvar_helper(session->channel, "FAXBOT_T38_GATEWAY")) {
+		state->faxbot_gateway = 1;
+	}
+}
