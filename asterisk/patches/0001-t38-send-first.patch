 /*! \brief Supplement for adding framehook to session channel */
+/*!
+ * \brief Faxbot: one NOTICE line per T.38 stream when its session ends.
+ *
+ * Where the opening packets went, the UDPTL packets sent and received, and
+ * whether a T.38 gateway engaged (res_fax_spandsp sets FAXBOT_T38_GATEWAY on
+ * the T.38 channel when it starts one), so a failed T.38 call explains itself.
+ */
+static void t38_session_end(struct ast_sip_session *session)
+{
+	RAII_VAR(struct ast_datastore *, datastore, ast_sip_session_get_datastore(session, "t38"), ao2_cleanup);
+	struct t38_state *state = datastore ? datastore->data : NULL;
+	struct ast_sip_session_media *media = NULL;
+	unsigned int sent = 0, received = 0;
+	const char *gateway = NULL;
+	char opened[AST_SOCKADDR_BUFLEN] = "nowhere";
+
+	if (!state || !state->opened) {
+		return;
+	}
+	if (session->active_media_state) {
+		media = session->active_media_state->default_session[AST_MEDIA_TYPE_IMAGE];
+	}
+	if (media && media->udptl) {
+		ast_udptl_get_counts(media->udptl, &sent, &received);
+	}
+	if (!ast_sockaddr_isnull(&state->opened_to)) {
+		ast_copy_string(opened, ast_sockaddr_stringify(&state->opened_to), sizeof(opened));
+	}
+	if (session->channel) {
+		ast_channel_lock(session->channel);
+		gateway = pbx_builtin_getvar_helper(session->channel, "FAXBOT_T38_GATEWAY");
+		ast_log(LOG_NOTICE, "Faxbot T.38 on %s: %d opening packets to %s; %u packets sent, %u received; "
+			"T.38 gateway %s\n", ast_channel_name(session->channel), FAXBOT_T38_OPENING_PACKETS, opened, sent,
+			received, gateway ? gateway : "not engaged (none, or Asterisk's own fax engine)");
+		ast_channel_unlock(session->channel);
+	} else {
+		ast_log(LOG_NOTICE, "Faxbot T.38: %d opening packets to %s; %u packets sent, %u received\n",
+			FAXBOT_T38_OPENING_PACKETS, opened, sent, received);
+	}
+}
+
 static struct ast_sip_session_supplement t38_supplement = {
 	.method = "INVITE",
 	.priority = AST_SIP_SUPPLEMENT_PRIORITY_CHANNEL + 1,
 	.incoming_request = t38_incoming_invite_request,
 	.outgoing_request = t38_outgoing_invite_request,
+	.session_end = t38_session_end,
 };
 
