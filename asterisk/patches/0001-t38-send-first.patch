 /*! \brief Supplement for adding framehook to session channel */
+/*!
+ * \brief Faxbot: keep what a T.38 gateway recorded on the channel, while the channel exists.
+ *
+ * res_fax_spandsp sets FAXBOT_T38_GATEWAY on the T.38 channel when a gateway
+ * starts (0002), and FAXBOT_T38_EMPTY_PREAMBLES and FAXBOT_T38_EMPTY_TRAININGS
+ * each time it ends a signal the far end left open (0002, 0003). Read at the
+ * BYE (either direction) and at session end, because an outbound call ended
+ * from this side has no channel left when its session ends.
+ */
+static void faxbot_t38_keep(struct ast_sip_session *session)
+{
+	RAII_VAR(struct ast_datastore *, datastore, ast_sip_session_get_datastore(session, "t38"), ao2_cleanup);
+	struct t38_state *state = datastore ? datastore->data : NULL;
+	const char *value;
+
+	if (!state || !session->channel) {
+		return;
+	}
+	ast_channel_lock(session->channel);
+	if (pbx_builtin_getvar_helper(session->channel, "FAXBOT_T38_GATEWAY")) {
+		state->faxbot_gateway = 1;
+	}
+	if ((value = pbx_builtin_getvar_helper(session->channel, "FAXBOT_T38_EMPTY_PREAMBLES"))) {
+		sscanf(value, "%30u", &state->faxbot_empty_preambles);
+	}
+	if ((value = pbx_builtin_getvar_helper(session->channel, "FAXBOT_T38_EMPTY_TRAININGS"))) {
+		sscanf(value, "%30u", &state->faxbot_empty_trainings);
+	}
+	ast_channel_unlock(session->channel);
+}
+
+/*!
+ * \brief Faxbot: one NOTICE line per T.38 stream when its session ends.
+ *
+ * Where the opening packets went, the T.38 packets sent (opening packets
+ * included) and received over the session's T.38 streams, counted in this
+ * module's own read and write callbacks, and whether a T.38 gateway engaged,
+ * with how many signals the far end left open it ended (0002 and 0003 log only
+ * the first of each in a call, because the far end decides how often they
+ * come), so a failed T.38 call explains itself.
+ */
+static void t38_session_end(struct ast_sip_session *session)
+{
+	RAII_VAR(struct ast_datastore *, datastore, ast_sip_session_get_datastore(session, "t38"), ao2_cleanup);
+	struct t38_state *state = datastore ? datastore->data : NULL;
+	char opened[AST_SOCKADDR_BUFLEN];
+	char gateway[160];
+
+	if (!state || ast_sockaddr_isnull(&state->opened_to)) {
+		return;	/* no T.38 stream in this session */
+	}
+	ast_copy_string(opened, ast_sockaddr_stringify(&state->opened_to), sizeof(opened));
+	/* The channel may already have gone (an outbound call ended from this side): use what was kept. */
+	faxbot_t38_keep(session);
+	if (state->faxbot_gateway) {
+		snprintf(gateway, sizeof(gateway), "engaged (it ended %u empty V.21 signals and %u open fast modem "
+			"signals from the far end)", state->faxbot_empty_preambles, state->faxbot_empty_trainings);
+	} else {
+		ast_copy_string(gateway, "not engaged (none, or Asterisk's own fax engine)", sizeof(gateway));
+	}
+	ast_log(LOG_NOTICE, "Faxbot T.38 on %s: %d opening packets to %s; %d packets sent, %d received; "
+		"T.38 gateway %s\n", S_OR(state->faxbot_channel, "an unnamed channel"), FAXBOT_T38_OPENING_PACKETS,
+		opened, state->faxbot_sent, state->faxbot_received, gateway);
+}
+
+/*! \brief Faxbot: a BYE from the far end; the channel still exists */
+static int faxbot_t38_incoming_bye(struct ast_sip_session *session, struct pjsip_rx_data *rdata)
+{
+	faxbot_t38_keep(session);
+	return 0;
+}
+
+/*! \brief Faxbot: a BYE from this side, sent before the channel leaves the session */
+static void faxbot_t38_outgoing_bye(struct ast_sip_session *session, struct pjsip_tx_data *tdata)
+{
+	faxbot_t38_keep(session);
+}
+
+static struct ast_sip_session_supplement faxbot_t38_bye_supplement = {
+	.method = "BYE",
+	.incoming_request = faxbot_t38_incoming_bye,
+	.outgoing_request = faxbot_t38_outgoing_bye,
+};
+
 static struct ast_sip_session_supplement t38_supplement = {
 	.method = "INVITE",
 	.priority = AST_SIP_SUPPLEMENT_PRIORITY_CHANNEL + 1,
 	.incoming_request = t38_incoming_invite_request,
 	.outgoing_request = t38_outgoing_invite_request,
+	.session_end = t38_session_end,
 };
 
