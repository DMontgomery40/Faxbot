#!/bin/sh
# Hand one received fax to Faxbot. Called (through SHELL) from the
# faxbot-inbound-done dialplan with key=value words that the dialplan already
# reduced to safe characters; each value is checked again here before it
# enters the JSON body. The shared secret and API address come from the
# environment or Faxbot's data folder and are never printed.
#
# Prints one word for the dialplan: "ok", or why the hand-over failed:
#   no_secret      no inbound secret yet (Faxbot writes one on Apply to Asterisk)
#   refused        Faxbot refused the secret
#   not_receiving  receiving is turned off in Faxbot
#   unreadable     the image is missing or outside the inbound folder
#   unreachable    Faxbot could not be reached
#   failed         Faxbot answered with an error
# A failure also goes to standard error and the exit status is 1. The image
# stays where it is; Faxbot brings in an image that was never handed over by
# itself once the cause is fixed. A request is repeated only when Faxbot could
# not be reached or was still starting; the hand-over is idempotent per call.
set -u

data=${FAXBOT_DATA_DIR:-/faxdata}
file='' did='' caller='' status='' pages='' mode='' started='' answered='' ended='' uniqueid='' station64=''
callid64='' rate='' resolution='' sub=''

fail() {
  printf '%s\n' "$1"
  printf 'faxbot-inbound-notify: received fax %s was not handed to Faxbot (%s)\n' "${uniqueid:-unknown}" "$1" >&2
  exit 1
}

for word in "$@"; do
  key=${word%%=*}
  value=${word#*=}
  case $key in
    file) case $value in "$data"/inbound/*.tiff) file=$value ;; esac ;;
    did) did=$(printf '%s' "$value" | tr -cd '0123456789+') ;;
    caller) caller=$(printf '%s' "$value" | tr -cd '0123456789+') ;;
    status) status=$(printf '%s' "$value" | tr -cd 'A-Z_') ;;
    pages) pages=$(printf '%s' "$value" | tr -cd '0-9') ;;
    mode) mode=$(printf '%s' "$value" | tr -cd 'T38audio') ;;
    started) started=$(printf '%s' "$value" | tr -cd '0-9') ;;
    answered) answered=$(printf '%s' "$value" | tr -cd '0-9') ;;
    ended) ended=$(printf '%s' "$value" | tr -cd '0-9') ;;
    uniqueid) uniqueid=$(printf '%s' "$value" | tr -cd '0-9.') ;;
    station64) station64=$(printf '%s' "$value" | tr -cd 'A-Za-z0-9+/=') ;;
    callid64) callid64=$(printf '%s' "$value" | tr -cd 'A-Za-z0-9+/=') ;;
    # The last page's speed and resolution (measurement only; Faxbot keeps them when a page was confirmed).
    rate) rate=$(printf '%s' "$value" | tr -cd '0-9') ;;
    resolution) resolution=$(printf '%s' "$value" | tr -cd '0-9x') ;;
    # The subaddress frame (SUB) the sender's machine sent, in hex (patch 0004), for Faxbot's number rules.
    sub) sub=$(printf '%s' "$value" | tr -cd '0-9a-f' | cut -c1-64) ;;
  esac
done
case $file in
  "$data"/inbound/*.tiff) ;;
  *) fail unreadable ;;
esac
case $file in
  *[!A-Za-z0-9/._-]*) fail unreadable ;;
esac
[ -f "$file" ] || fail unreadable
secret=${ASTERISK_INBOUND_SECRET:-}
# Faxbot writes the secret here (mode 0600) when it starts and on Apply to Asterisk.
if [ -z "$secret" ] && [ -f "$data/asterisk/inbound.secret" ]; then
  secret=$(cat "$data/asterisk/inbound.secret")
fi
[ -n "$secret" ] || fail no_secret

number() { if [ -n "$1" ]; then printf '%s' "$1"; else printf 'null'; fi; }
text() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }
case $mode in
  T38) t38=true ;;
  audio) t38=false ;;
  *) t38=null ;;
esac

body=$(printf '{"tiff_path":"%s","to_number":%s,"from_number":%s,"faxstatus":%s,"faxpages":%s,"uniqueid":%s,"sub_hex":%s,"call":{"did":%s,"caller":%s,"started_at":%s,"answered_at":%s,"ended_at":%s,"pages":%s,"t38":%s,"remote_station_id_b64":%s,"sip_call_id_b64":%s,"rate":%s,"resolution":%s}}' \
  "$file" "$(text "$did")" "$(text "$caller")" "$(text "$status")" "$(number "$pages")" "$(text "$uniqueid")" \
  "$(text "$sub")" \
  "$(text "$did")" "$(text "$caller")" "$(number "$started")" "$(number "$answered")" "$(number "$ended")" \
  "$(number "$pages")" "$t38" "$(text "$station64")" "$(text "$callid64")" "$(number "$rate")" \
  "$(text "$resolution")")

url="${FAXBOT_API_URL:-http://api:8080}/_internal/asterisk/inbound"
attempt=0
while [ "$attempt" -lt 5 ]; do
  attempt=$((attempt + 1))
  code=$(printf 'X-Internal-Secret: %s\n' "$secret" | curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 \
    --max-time 60 -H @- -H 'Content-Type: application/json' --data-binary "$body" "$url" 2>/dev/null)
  result=$?
  if [ "$result" -eq 0 ]; then
    case $code in
      2??) printf 'ok\n'; exit 0 ;;
      401|403) fail refused ;;
      404) fail not_receiving ;;
      400|413|422) fail unreadable ;;
      503) ;;  # Faxbot is starting; try again.
      *) fail failed ;;
    esac
  elif [ "$result" -ne 7 ]; then
    # Sent but no answer: Faxbot may have it, and a repeat could not help.
    fail unreachable
  fi
  # 7: could not connect, so Faxbot cannot have received this fax yet.
  sleep "${FAXBOT_NOTIFY_RETRY_SECONDS:-3}"
done
fail unreachable
